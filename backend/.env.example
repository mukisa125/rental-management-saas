# ============================================================
# RENTAL MANAGEMENT SAAS - BACKEND CONFIGURATION
# ============================================================
# Copy this file to .env.local and fill in your actual credentials
# DO NOT commit real credentials to git
# ============================================================

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/rental-management
NODE_ENV=development

# JWT & Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Port
PORT=5000

# ============================================================
# MOBILE MONEY GATEWAYS - MTN & AIRTEL
# ============================================================

# --- MTN MOBILE MONEY UGANDA ---
# Sandbox (for testing): https://api.sandbox.mtn.co.ug/v1
# Production: https://api.mtn.co.ug/v1
# Get credentials: https://developer.mtn.co.ug

MTN_API_BASE_URL=https://api.sandbox.mtn.co.ug/v1
MTN_API_KEY=your_mtn_api_key_from_dashboard
MTN_SECRET_KEY=your_mtn_secret_key_for_webhooks
MTN_API_USER=your_mtn_api_username_optional
MTN_API_PASSWORD=your_mtn_api_password_optional

# --- AIRTEL MONEY UGANDA ---
# Sandbox (for testing): https://api.sandbox.airtel.ug/v1
# Production: https://api.airtel.ug/v1
# Get credentials: https://developer.airtel.ug

AIRTEL_API_BASE_URL=https://api.sandbox.airtel.ug/v1
AIRTEL_CLIENT_ID=your_airtel_client_id_from_oauth
AIRTEL_CLIENT_SECRET=your_airtel_client_secret_from_oauth
AIRTEL_API_KEY=your_airtel_api_key_for_webhooks

# ============================================================
# ALTERNATIVE PAYMENT PROVIDERS (Optional)
# ============================================================

# Stripe (Card Payments)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Flutterwave (African Payment Gateway)
FLUTTERWAVE_PUBLIC_KEY=pk_test_your_flutterwave_key
FLUTTERWAVE_SECRET_KEY=sk_test_your_flutterwave_secret

# ============================================================
# EMAIL CONFIGURATION (for notifications)
# ============================================================

# SMTP Settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_not_regular_password
SMTP_FROM=noreply@rentalsys.ug

# ============================================================
# OPTIONAL: SMS/WhatsApp Notifications
# ============================================================

# WhatsApp Business API (for payment notifications)
WHATSAPP_API_BASE_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ============================================================
# LOGGING & MONITORING
# ============================================================

LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================
# APP SETTINGS
# ============================================================

# Default subscription settings
DEFAULT_TRIAL_DAYS=14
DEFAULT_BILLING_CYCLE=monthly

# Company settings
MAX_PROPERTIES_FREE_TIER=3
MAX_UNITS_FREE_TIER=10
MAX_MANAGERS_FREE_TIER=1

# ============================================================
# FILE UPLOAD SETTINGS
# ============================================================

MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xlsx,xls

# ============================================================
# FRONTEND URL (for email links, redirects)
# ============================================================

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ============================================================
# WEBHOOK SETTINGS
# ============================================================

# Webhook URLs (used when signing up with payment gateways)
WEBHOOK_MTN=http://localhost:5000/api/billing/mobile-money/mtn/webhook
WEBHOOK_AIRTEL=http://localhost:5000/api/billing/mobile-money/airtel/webhook
WEBHOOK_STRIPE=http://localhost:5000/api/payments/stripe/webhook
WEBHOOK_PAYPAL=http://localhost:5000/api/payments/paypal/webhook

# ============================================================
# SECURITY
# ============================================================

# CORS Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Password settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# ============================================================
# NOTES FOR SETUP
# ============================================================
# 
# 1. For MTN Mobile Money:
#    - Sign up at https://developer.mtn.co.ug
#    - Create an application
#    - Generate API Keys in dashboard
#    - Copy API_KEY, SECRET_KEY here
#    - Use sandbox URL for testing, production URL for live
#
# 2. For Airtel Money:
#    - Sign up at https://developer.airtel.ug
#    - Create application
#    - Generate OAuth2 credentials
#    - Copy CLIENT_ID, CLIENT_SECRET, API_KEY here
#
# 3. Testing without credentials:
#    - Leave MTN_API_BASE_URL and AIRTEL_API_BASE_URL empty/commented
#    - System will use MOCK mode automatically
#    - Perfect for local development
#
# 4. Switching from Sandbox to Production:
#    - Update URLs from sandbox.* to live URLs
#    - Generate new production API keys
#    - Test thoroughly before going live
#
